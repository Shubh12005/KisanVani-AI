# ==============================================================================
# KisanVani Voice-First Multilingual Agri-Advisory Environment Configuration
# ==============================================================================

# LLM Configuration (Google Gemini)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Backend & Server Settings
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501,*

# Embedding & Vector Database Settings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=4
SIMILARITY_THRESHOLD=1.25

# Optional Database (if logging interactions)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kisanvani_db
